{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zim-cas.dev/schema/api-v2-beta.schema.json",
  "title": "Zim Core API v2 Beta",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" }],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["apiVersion", "operation"],
      "properties": {
        "apiVersion": { "const": "2.0-beta" },
        "requestId": { "type": "string" },
        "operation": {
          "enum": [
            "parse",
            "simplify",
            "solve",
            "solveSystem",
            "format",
            "latex",
            "capabilities",
            "analyzePolynomial",
            "solveRelation",
            "solveNonlinearSystem",
            "derive",
            "differentiate",
            "limit",
            "integrate"
          ]
        },
        "expression": { "type": "string" },
        "relation": { "type": "string" },
        "expressions": { "type": "array", "items": { "type": "string" } },
        "equations": { "type": "array", "items": { "type": "string" } },
        "variable": { "type": "string" },
        "variables": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "domain": { "enum": ["real", "complex"] },
        "includeSteps": { "type": "boolean" },
        "mode": { "enum": ["exact", "numeric"] },
        "initialGuess": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "maxIterations": { "type": "integer", "minimum": 1 },
        "tolerance": { "type": "number", "exclusiveMinimum": 0 },
        "maxResultantDegree": { "type": "integer", "minimum": 1 },
        "renderMode": { "enum": ["concise", "classroom", "diagnostic"] },
        "locale": { "type": "string" },
        "point": { "type": "string" },
        "direction": { "enum": ["both", "left", "right"] },
        "lower": { "type": "string" },
        "upper": { "type": "string" },
        "integrationMode": { "enum": ["symbolic", "numeric"] },
        "precisionDigits": { "type": "integer", "minimum": 1, "maximum": 200 },
        "maxSeriesTerms": { "type": "integer", "minimum": 1 },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxInputLength": { "type": "integer", "minimum": 1 },
            "maxAstNodes": { "type": "integer", "minimum": 1 },
            "maxNestingDepth": { "type": "integer", "minimum": 1 },
            "maxPolynomialDegree": { "type": "integer", "minimum": 1 },
            "maxCandidateRoots": { "type": "integer", "minimum": 1 },
            "maxDerivationNodes": { "type": "integer", "minimum": 1 },
            "maxIterations": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            { "properties": { "operation": { "const": "capabilities" } } },
            {
              "properties": { "operation": { "enum": ["parse", "format", "latex"] } },
              "required": ["expression"]
            },
            {
              "properties": { "operation": { "const": "simplify" } },
              "required": ["expression"]
            },
            {
              "properties": { "operation": { "const": "solve" } },
              "required": ["expression", "variable"]
            },
            {
              "properties": { "operation": { "const": "analyzePolynomial" } },
              "required": ["expression", "variable"]
            },
            {
              "properties": { "operation": { "const": "solveRelation" } },
              "required": ["relation", "variable"]
            },
            {
              "properties": { "operation": { "const": "solveSystem" } },
              "required": ["expressions", "variables"]
            },
            {
              "properties": { "operation": { "const": "solveNonlinearSystem" } },
              "required": ["equations", "variables"]
            },
            {
              "properties": { "operation": { "const": "derive" } },
              "required": ["expression", "variable"]
            },
            {
              "properties": { "operation": { "const": "differentiate" } },
              "required": ["expression", "variables"]
            },
            {
              "properties": { "operation": { "const": "limit" } },
              "required": ["expression", "variable", "point"]
            },
            {
              "properties": { "operation": { "const": "integrate" } },
              "required": ["expression", "variable"]
            }
          ]
        }
      ]
    },
    "response": {
      "type": "object",
      "required": ["apiVersion", "requestId", "status", "diagnostics", "timing"],
      "properties": {
        "apiVersion": { "const": "2.0-beta" },
        "requestId": { "type": "string" },
        "status": {
          "enum": ["ok", "unsupported", "invalid", "budget-exceeded", "internal-error"]
        },
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        },
        "diagnostics": {
          "type": "object",
          "required": ["operation"],
          "properties": {
            "operation": { "type": "string" },
            "code": { "type": "string" }
          }
        },
        "timing": {
          "type": "object",
          "required": ["totalMs"],
          "properties": { "totalMs": { "type": "number", "minimum": 0 } }
        }
      }
    }
  }
}
