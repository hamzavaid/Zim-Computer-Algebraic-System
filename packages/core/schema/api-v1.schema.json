{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zim-cas.dev/schema/api-v1.schema.json",
  "title": "Zim Core API v1",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" }],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "operation"],
      "properties": {
        "version": { "const": "1.0" },
        "operation": {
          "enum": ["parse", "simplify", "solve", "solve-system", "format", "latex"]
        },
        "expression": { "type": "string", "minLength": 1 },
        "expressions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "variable": { "type": "string", "minLength": 1 },
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "domain": { "enum": ["real", "complex"] },
        "includeSteps": { "type": "boolean" }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "status", "result"],
          "properties": {
            "version": { "const": "1.0" },
            "status": { "const": "ok" },
            "result": { "type": "object" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "status", "error"],
          "properties": {
            "version": { "const": "1.0" },
            "status": { "const": "error" },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" },
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      ]
    }
  }
}
