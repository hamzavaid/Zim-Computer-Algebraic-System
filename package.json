{
  "name": "zim-computer-algebraic-system",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "Zim 2.0 exact symbolic mathematics engine",
  "type": "commonjs",
  "main": "packages/core/dist/index.js",
  "bin": {
    "zim": "packages/cli/dist/cli.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.js",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "build:cli": "tsc -p packages/cli/tsconfig.json",
    "build:gui": "tsc -p packages/gui/tsconfig.json",
    "build": "npm run build:core && npm run build:cli && npm run build:gui",
    "test": "npm run build && node --test packages/core/test/*.test.js packages/cli/test/*.test.js packages/gui/test/*.test.js",
    "lint": "eslint packages/core/src packages/cli/src packages/gui/src",
    "start:gui": "npm run build && node packages/gui/dist/server.js",
    "format:check": "prettier --check \"packages/**/*.{ts,js,json,html,css}\" \"datasets/**/*.json\" \".github/**/*.yml\" README.md package.json",
    "check": "npm run test && npm run lint && npm run format:check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "license": "ISC"
}
